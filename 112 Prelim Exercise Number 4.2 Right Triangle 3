import java.util.Scanner;               // Import Scanner

public class RightTriangle3 {                            // class declaration
    public static void main(String [] args) {           // main method declaration

        // Declare Scanner
        Scanner input = new Scanner (System.in);

        //declare the variables
        int base;
        int height;
        double hypotenuse;
        double baseSquared;
        double heightSquared;
        double areaOfRightTriangle;
        double perimeterOfRightTriangle;

        //Input base of the right triangle
        System.out.println("");
        System.out.print("Please enter base of a right triangle: ");
        base = input.nextInt();

        //Input height of the right triangle
        System.out.print("Please enter the height of a right triangle: ");
        height = input.nextInt();

        //Computation of hypotenuse, perimeter and area of the right triangle
        baseSquared = Math.pow(base, 2);
        heightSquared = Math.pow(height, 2);
        hypotenuse = Math.sqrt(baseSquared + heightSquared);
        perimeterOfRightTriangle = base + height + hypotenuse;
        areaOfRightTriangle = 0.5 * (base * height);

        //Display all values associaed to the right triangle
        System.out.println("***************************************************************");
        System.out.println("    The base of the right triangle is: " + base);
        System.out.println("    The height of the right triangle is: " + height);
        System.out.println("    The hypotenuse of the right triangle is: " + hypotenuse);
        System.out.println("    The perimeter of the right triangle is: " + perimeterOfRightTriangle);
        System.out.println("    The area of the right triangle is: " + areaOfRightTriangle);
        System.out.println("***************************************************************");

        System.exit(0);                          //Program termination
    }                                          // end of main method
}                                               // end of exercise 2.4
