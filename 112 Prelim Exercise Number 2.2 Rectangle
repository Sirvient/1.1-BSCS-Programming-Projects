public class Rectangle {
    public static void main(String [] args) {
        int length;
        int width;
        double perimeter;
        double areaOfRectangle;

        length = 10;
        width = 15;
        perimeter = 2*length + 2*width;
        areaOfRectangle = length*width;

        System.out.println("");
        System.out.println("");
        System.out.println("**********************************************************");
        System.out.println("*                                                        *");
        System.out.println("*                                                        *");

        // Dimensions of the rectangle
        System.out.println("*      Dimensions of the rectangle are the following:    *");
        System.out.println("*                       Length = " + length + "                      *");
        System.out.println("*                        Width = " + width + "                      *");
        System.out.println("*                                                        *");

        //Computation of the Perimeter of the rectangle
        System.out.println("*           perimeter of the rectangle is " + perimeter + "           *");

        //Computation of the Area of the rectangle
        System.out.println("*             Area of the rectangle is " + areaOfRectangle + "             *");
        System.out.println("*                                                        *");
        System.out.println("*                                                        *");
        System.out.println("**********************************************************");
    }
}
