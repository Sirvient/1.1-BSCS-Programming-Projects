import java.util.Scanner;                               //Import scanner

public class Square3 {                                  // class declaration
    public static void main(String [] args) {           // main method declaration
        //declare scanner
        Scanner input = new Scanner (System.in);

        //declare variables
        int side;
        int perimeter;
        int areaOfSquare;

        // Dimensions of the square
        System.out.println("");
        System.out.print("Please enter the side of a square: ");
        side = input.nextInt();

        //Computation of the Area and Perimeter of the square
        perimeter = 4*side;
        areaOfSquare = side*side;

        //Display associated values of the Square
        System.out.println("");
        System.out.println("**********************************************************");
        System.out.println("           The side of a square is: " + side);
        System.out.println("         Perimeter of the square is: " + perimeter);
        System.out.println("           Area of the square is: " + areaOfSquare);
        System.out.println("**********************************************************");

        System.exit(0);         // terminate program
    }                                 // end of main method
}                                     // end of exercise 2.3
