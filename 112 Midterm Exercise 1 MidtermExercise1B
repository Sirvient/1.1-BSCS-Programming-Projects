import java.util.Scanner;
public class MidtermExercise1B {
    public static void main(String[] args) {
        //Scanner declaration
        Scanner input = new Scanner(System.in);

        //assigning values
        int totalExamScore;
        int totalQuizScore;
        int quizScore;
        int examScore;
        double examGrade;
        double quizGrade;
        double prelimGrade;

        //Read and accept the perfect total quiz score wherein score cannot be lower than zero. Accepts another input.
        System.out.print("Enter perfect total quiz score: ");
        totalQuizScore = Integer.parseInt(input.nextLine());
        while (totalQuizScore < 0) {
            System.out.println("--- Invalid Value! Value must be greater than 0. ---");
            System.out.print("Enter perfect total quiz Score: ");
            totalQuizScore = Integer.parseInt(input.nextLine());
        }

        //Read and accept the perfect total exam score wherein score cannot be lower than zero. Accepts another input.
        System.out.print("Enter perfect total exam Score: ");
        totalExamScore = Integer.parseInt(input.nextLine());
        while (totalExamScore < 0) {
            System.out.println("--- Invalid Value! Value must be greater than 0. ---");
            System.out.print("Enter perfect total exam Score: ");
            totalExamScore = Integer.parseInt(input.nextLine());
        }

        /*Read and accept the student's quiz score wherein score cannot be lower than zero and not greater than
        the perfect total quiz score. Accepts another input.*/
        System.out.print("Enter student's quiz score: ");
        quizScore = Integer.parseInt(input.nextLine());
        while (quizScore < 0 || quizScore > totalQuizScore) {
            if (quizScore < 0) {
                System.out.println("--- Invalid Value! Value must be greater than 0. ---");
                System.out.print("Enter student's quiz score: ");
                quizScore = Integer.parseInt(input.nextLine());
            } else {
                System.out.println("--- Invalid Value! Value cannot exceed the Perfect Total Quiz Score. ---");
                System.out.print("Enter student's quiz score: ");
                quizScore = Integer.parseInt(input.nextLine());
            }
        }

        /*Read and accept the student's exam score wherein score cannot be lower than zero and not greater than
        the perfect total exam score. Accepts another input.*/
        System.out.print("Enter student's exam score: ");
        examScore = Integer.parseInt(input.nextLine());
        while (examScore < 0 || examScore > totalExamScore) {
            if (examScore < 0) {
                System.out.println("--- Invalid Value! Value must be greater than 0. ---");
                System.out.print("Enter student's exam score: ");
                examScore = Integer.parseInt(input.nextLine());
            } else {
                System.out.println("--- Invalid Value! Value cannot exceed the Perfect Total Exam Score. ---");
                System.out.print("Enter student's exam score: ");
                examScore = Integer.parseInt(input.nextLine());
            }
        }

        //Computations for the exam grade, quiz grade and prelim grade.
        examGrade = (((double) examScore / totalExamScore) * 50) + 50;
        quizGrade = (((double) quizScore / totalQuizScore) * 50) + 50;
        prelimGrade = (examGrade + quizGrade) / 2;

        //Determine if grade is less than 65 and reset prelim grade to 65 when true.
        if (prelimGrade < 65) {
            prelimGrade = 65;
        }

        //Determine if grade is greater than 99 and reset prelim grade to 99 when true.
        if (prelimGrade > 99) {
            prelimGrade = 99;
        }

        //Display the student's prelim grade and remarks if FAILED or PASSED.
        if (prelimGrade >= 75) {
            System.out.println("---------------------------------------------------------");
            System.out.println("Prelim grade is: " + prelimGrade);
            System.out.println("Remarks: PASSED");
            System.out.println("---------------------------------------------------------");
        } else {
            System.out.println("---------------------------------------------------------");
            System.out.println("Prelim grade is: " + prelimGrade);
            System.out.println("Remarks: FAILED");
            System.out.println("---------------------------------------------------------");
        }

    }
}

