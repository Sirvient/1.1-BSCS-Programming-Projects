import java.util.Scanner;

public class MidtermExercise4 {
    public static void main(String[] args) {
        //scanner name from kbd to input
        Scanner input = new Scanner(System.in);

        //pName to productName
        String productName = "";

        //uPrice to unitPrice, totalCost to totalPurchaseAmount, discountedCost to discountedTotalPurchaseAmount, amountTendered to cashTendered
        double unitPrice, totalPurchaseAmount, discount, discountedTotalPurchaseAMount, cashTendered, change;

        //qty to quantity, dRate to discountedRate
        int quantity, discountRate;

        System.out.print("Product: ");
        productName = input.nextLine();

        //While statement is used to repeatedly accept input as long as an invalid value is entered.
        System.out.print("Quantity: ");
        quantity = Integer.parseInt(input.nextLine());
        while (quantity <= 0){
            System.out.println("------- Quantity should be greater than zero. Please enter a valid number. -------");
            System.out.print("Quantity: ");
            quantity = Integer.parseInt(input.nextLine());
        }

        //While statement is used to repeatedly accept input as long as an invalid value is entered.
        System.out.print("Unit Price: ");
        unitPrice = Double.parseDouble(input.nextLine());
        while (unitPrice <= 0){
            System.out.println("------- Unit Price must be greater than zero. Please enter a valid number. -------");
            System.out.print("Unit Price: ");
            unitPrice = Double.parseDouble(input.nextLine());
        }

        //While statement is used to repeatedly accept input as long as an invalid value is entered.
        System.out.print("Discount: ");
        discountRate = Integer.parseInt(input.nextLine());
        while (discountRate < 0 || discountRate > 100){
            System.out.println("------- Discount cannot be a negative value and cannot exceed 100. Please enter a valid number. -------");
            System.out.print("Discount: ");
            discountRate = Integer.parseInt(input.nextLine());
        }

        totalPurchaseAmount = unitPrice * quantity;
        discount = totalPurchaseAmount * (discountRate / 100.0);
        discountedTotalPurchaseAMount = totalPurchaseAmount - discount;

        //While statement is used to repeatedly accept input as long as an invalid value is entered.
        System.out.print("Cash Tendered: ");
        cashTendered = Double.parseDouble(input.nextLine());
        while(cashTendered < discountedTotalPurchaseAMount) {
            System.out.println("------- Discount cannot be a negative value and cannot exceed 100. Please enter a valid number. -------");
            System.out.print("Cash Tendered: ");
            cashTendered = Double.parseDouble(input.nextLine());
        }

        change = cashTendered - discountedTotalPurchaseAMount;

        System.out.printf("%-25s%12s%n", "---------------", "--------------");
                System.out.printf("%-25s%12.2f%n", "Total Purchase Amount: ",
                        totalPurchaseAmount);
        System.out.printf("%-25s%12.2f%n", "Total Discount: ", discount);
        System.out.printf("%-25s%12.2f%n", "Amount to be Paid: ",
                discountedTotalPurchaseAMount);
        System.out.printf("%-25s%12.2f%n", "change: ", change);
        System.exit(0);
    } // end of main method
} // end of class
