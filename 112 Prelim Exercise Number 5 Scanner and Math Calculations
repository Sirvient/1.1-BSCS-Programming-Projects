import java.util.Scanner;

public class Exercise5 {
    // Scanner input
    static Scanner input = new Scanner(System.in);

    // assigning values
    static int n1;
    static int n2;
    static int n3;
    static int sum;


    public static void main(String [] args) {
        // get input for three integers
        System.out.print("First Number: ");
        n1 = Integer.parseInt(input.nextLine());

        System.out.print("Second Number: ");
        n2 = Integer.parseInt(input.nextLine());

        System.out.print("Third Number: ");
        n3 = Integer.parseInt(input.nextLine());
        System.out.println("***********************************************************************************");



        // display the three numbers
        System.out.println ("You entered the numbers " + n1 + ", " + n2 + " and " + n3 + ".");
        System.out.println("-----------------------------------------------------------------------------------");

        // Add the three numbers and display their sum
        sum = n1 + n2 + n3;
        System.out.println("The sum of the three numbers is " + sum);
        System.out.println("-----------------------------------------------------------------------------------");

        // divide n1 by n2 and display their quotient
        System.out.println("Integer and Actual quotient of the first number divided by the second number");
        int q1 = n1 / n2;
        System.out.println("The integer quotient of the expression is: " + q1);

        double q2 = (double) n1 / n2;
        System.out.println("The actual quotient of the expression is: " + q2);
        System.out.println("-----------------------------------------------------------------------------------");

/* #1. Compute the product of the three numbers, store it in another integer variable and display this value.
INSERT THE CODES BELOW... */
        int productOfTheThreeNumbers = n1 * n2 * n3;
        System.out.println("The product of the three numbers is: " + productOfTheThreeNumbers);
        System.out.println("-----------------------------------------------------------------------------------");

/* #2. Get the sum of the first two numbers and divide it by the third number, compute only for the integer quotient and display the value.
INSERT THE CODES BELOW... */
        int sumOfTheFirstTwoNumbers = n1 + n2;
        int IntegerQuoientOfTheThirdNumberAndSumOfTheFirstTwoNumbers = sumOfTheFirstTwoNumbers / n3;
        System.out.println("Integer and Actual quotient of the sum of the first two numbers divided by the third number");
        System.out.println("The integer quotient of the expression is: " + IntegerQuoientOfTheThirdNumberAndSumOfTheFirstTwoNumbers);

/* #3. Get the sum of the first two numbers and divide it by the third number,compute for the exact quotient and display the value.
INSERT THE CODES BELOW... */
        double ActualQuoientOfTheThirdNumberAndSumOfTheFirstTwoNumbers = (double) sumOfTheFirstTwoNumbers / n3;
        System.out.println("The actual quotient of the expression is: " + ActualQuoientOfTheThirdNumberAndSumOfTheFirstTwoNumbers);
        System.out.println("-----------------------------------------------------------------------------------");

/* #4. Compute the average of the three numbers and display the result with 2 decimal values shown.
INSERT CODE BELOW... */
        double averageOfTheThreeNumbers = (double) sum / 3;
        System.out.printf("The average is %.2f", averageOfTheThreeNumbers);
        System.out.println("");
        System.out.println("-----------------------------------------------------------------------------------");

/* #5. Compute the square of each number and display the results.
INSERT CODE BELOW... */
        double n1Squared = Math.pow(n1,2);
        double n2Squared = Math.pow(n2,2);
        double n3Squared = Math.pow(n3,2);

        System.out.println("The square of the first number is: " + n1Squared);
        System.out.println("The square of the second number is: " + n2Squared);
        System.out.println("The square of the third number is: " + n3Squared);
    } // End of the main method
} // End of class Exercise5
