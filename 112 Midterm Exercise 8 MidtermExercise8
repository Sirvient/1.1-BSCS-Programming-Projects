import java.util.Scanner;

public class MidtermExercise8 {
    public static void main(String[] args) {
        Scanner kbd = new Scanner(System.in);

        // Display heading
        System.out.println("This program helps you solve for the roots of a Quadratic Equation.");
        System.out.println("You should enter the coefficients of the quadratic equation");

        // Read coefficients
        System.out.print("Enter a: ");
        double a = Double.parseDouble(kbd.nextLine());
        System.out.print("Enter b: ");
        double b = Double.parseDouble(kbd.nextLine());
        System.out.print("Enter c: ");
        double c = Double.parseDouble(kbd.nextLine());

        double discriminant = b * b - 4 * a * c;

        if (discriminant >= 0) {
            // Compute and show real roots
            double root1 = (-b + Math.sqrt(discriminant)) / (2 * a);
            double root2 = (-b - Math.sqrt(discriminant)) / (2 * a);
            System.out.println("The roots are: " + root1 + " and " + root2 + ".");
        } else {
            // Compute and show imaginary roots
            double realPart = -b / (2 * a);
            double imaginaryPart = Math.sqrt(-1 * discriminant) / (2 * a);

            String root1 = realPart + " + " + imaginaryPart + "i";
            String root2 = realPart + " - " + imaginaryPart + "i";

            System.out.println("The imaginary roots are: " + root1 + " and " + root2 + ".");
        }

        kbd.close();
        System.exit(0);
    }
}
