import java.lang.*;

public class RightTriangle2 {                               //class declaration
    public static void main (String [ ] args){        //main method declaration
        
        //Assigning data types
        double base;
        double height;
        double hypotenuse;
        double baseSquared;
        double heightSquared;
        
        //Assigning values
        base = 3;
        height = 4;
        baseSquared = Math.pow(base, 2);
        heightSquared = Math.pow(height, 2);
        hypotenuse = Math.sqrt(baseSquared + heightSquared);
        
        //Display values related to the right triangle
        System.out.println();
        System.out.println("The Dimensions of the Right Triangle are:");
        System.out.println("Base = " + base);
        System.out.println("height = " + height);
        System.out.println();
        
        //Compute for the hypotenuse of the right triangle
        System.out.println("The hypotenuse of the Right Triangle is " + hypotenuse);
        
        system.exit(0);        // terminate method
    }                                     // end of main method
}                                         // end of exercise 3.2