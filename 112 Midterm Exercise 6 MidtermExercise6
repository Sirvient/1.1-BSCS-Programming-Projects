Write a program for the computation of the tax due corresponding to a given taxable
income.

The tax due is determined based on the following table:
(taxableIncome <= 250000.00)                                            taxDue = 0.00
(taxableIncome > 250000.00 && taxableIncome <= 400000.00)               taxDue = 0.00 + (taxableIncome - 250000.00) * 0.15;
(taxableIncome > 400000.00 && taxableIncome <= 800000.00)               taxDue = 22500.00 + (taxableIncome - 400000.00) * 0.20;
(taxableIncome > 800000.00 && taxableIncome <= 2000000.00)              taxDue = 102500.00 + (taxableIncome - 800000.00) * 0.25;
(taxableIncome > 2000000.00 && taxableIncome <= 8000000.00)             taxDue = 402500.00 + (taxableIncome - 2000000.00) * 0.30;
(taxableIncome > 8000000.00)                                            taxDue = 2202500.00 + (taxableIncome - 8000000.00) * 0.35;
-----------------------------------------------
INPUT:      Taxable Income
PROCESS:    Read and Evaluate the taxable income
            Determine the tax due
OUTPUT:     Display tax due
-----------------------------------------------
Algorithm:
1. Read and evaluate the taxable income
2. Determine the tax due bracket
3. Determine the tax due
4. display tax due
*/

import java.util.Scanner;
public class MidtermActivity6 {
    public static void main(String[] args) {
        Scanner keyboard = new Scanner(System.in);
        double taxableIncome=0.0;
        double taxDue = 0.0;
        byte bracket = 0;


        System.out.println("Income Tax Computation");

        //Reads and validates input for taxable income wherein system cannot accept negative and character values.
        while (taxableIncome <= 0.00) {
            System.out.print("Enter the taxable income: ");

            if (keyboard.hasNextDouble()) {
                taxableIncome = keyboard.nextDouble();

                if (taxableIncome <= 0.00) {
                    System.out.println("Invalid value. Taxable Income cannot be less than or equal to zero.");
                }

            } else {
                System.out.println("Invalid input. Please enter a valid numerical value.");
                keyboard.nextLine();
            }
        }
        keyboard.nextLine();


        //Tax bracket determination
        if (taxableIncome <= 250000.00)
            bracket = 1;
        if (taxableIncome > 250000.00 && taxableIncome <= 400000.00)
            bracket = 2;
        if (taxableIncome > 400000.00 && taxableIncome <= 800000.00)
            bracket = 3;
        if (taxableIncome > 800000.00 && taxableIncome <= 2000000.00)
            bracket = 4;
        if (taxableIncome > 2000000.00 && taxableIncome <= 8000000.00)
            bracket = 5;
        if (taxableIncome > 8000000.00)
            bracket = 6;


        //tax due bracket locator and tax due computation
        switch (bracket) {
            case 1:
                taxDue = 0.00;
                break;
            case 2:
                taxDue = 0.00 + (taxableIncome - 250000.00) * 0.15;
                break;
            case 3:
                taxDue = 22500.00 + (taxableIncome - 400000.00) * 0.20;
                break;
            case 4:
                taxDue = 102500.00 + (taxableIncome - 800000.00) * 0.25;
                break;
            case 5:
                taxDue = 402500.00 + (taxableIncome - 2000000.00) * 0.30;
                break;
            case 6:
                taxDue = 2202500.00 + (taxableIncome - 8000000.00) * 0.35;
                break;
            default:
                taxDue = 0.00;


        } // end of switch-case
        System.out.println("--------------------------");
        System.out.printf("%s %.2f%n", "Tax Due = ", taxDue);
        System.out.println("--------------------------");
        System.exit(0);
    } // end of main method
} // end of Taxation class
