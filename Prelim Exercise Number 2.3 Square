public class Square {
    public static void main(String [] args) {
        int side;
        double perimeter;
        double areaOfSquare;

        side = 10;
        perimeter = 4*side;
        areaOfSquare = side*side;

        System.out.println("");
        System.out.println("");
        System.out.println("**********************************************************");
        System.out.println("*                                                        *");
        System.out.println("*                                                        *");

        // Dimensions of the square
        System.out.println("*               The side of a square is " + side + "               *");
        
        System.out.println("*                                                        *");

        //Computation of the Perimeter of the square
        System.out.println("*            Perimeter of the square is " + perimeter + "             *");

        //Computation of the Area of the square
        System.out.println("*              Area of the square is " + areaOfSquare + "               *");
        
        System.out.println("*                                                        *");
        System.out.println("*                                                        *");
        System.out.println("**********************************************************");
    }
}
