import java.util.Scanner;

public class MidtermExercise5 {
    public static void main(String[] args) {
        Scanner kbd = new Scanner(System.in);
        int numberOfSubjects;
        int counter = 1;
        int grade = 0;
        int units = 0;
        int totalGrade = 0;
        int totalUnits = 0;
        double average = 0.0;

        //Number of pairs of grades and units entered at run time.
        System.out.print("Please enter the number of pairs of grades and units: ");
        numberOfSubjects = Integer.parseInt(kbd.nextLine());
        while(numberOfSubjects <= 0){
            System.out.println("---- Invalid value of pairs of grades and units. Number of pairs of grades and units must be greater than 0. ----");
            System.out.print("Please enter the number of grades to be calculated: ");
            numberOfSubjects = Integer.parseInt(kbd.nextLine());
        }

        //"for" statement is used for repetitive execution of block until the number of pairs of grades and units are satisfied.
        for (counter = 1; counter <= numberOfSubjects; ++counter) {

            //"while" statement is used to repetitively request and accept input for the grade until value is valid.
            System.out.print("Enter the grade of the student for the subject " + counter + ": ");
            grade = Integer.parseInt(kbd.nextLine());
            while (grade < 65 || grade > 99){
                System.out.println("---- Invalid value. Grade cannot be lower than 65 and not greater than 99. ----");
                System.out.print("Enter the grade of the student for the subject " + counter + ": ");
                grade = Integer.parseInt(kbd.nextLine());
            }

            //"while" statement is used to repetitively request and accept input for the number of units until value provided is valid.
            System.out.print("Enter the number of units for the subject " + counter + ": ");
            units = Integer.parseInt(kbd.nextLine());
            while (units < 1 || units > 12){
                System.out.println("---- Invalid value. Number of units must be atleast 1 but not more than 12. ----");
                System.out.print("Enter the number of units for the subject " + counter + ": ");
                units = Integer.parseInt(kbd.nextLine());
            }

            totalGrade += grade * units;
            totalUnits += units;

            average = (double) totalGrade/totalUnits;
            System.out.printf("%s%.2f", "Average Grade = ", average);
            System.out.println("");
        }
        System.exit(0);
    }
}
